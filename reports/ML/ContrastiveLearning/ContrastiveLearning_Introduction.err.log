# Set derivatives to zero
eq1 = Eq(expr_a, 0)
eq2 = Eq(expr_b, 0)

# Solve the equations
solution = solve((eq1, eq2), (a, b))

# Print the results
print("Solution for a and b:")
print(f"a = {solution[a]}")
print(f"b = {solution[b]}")

